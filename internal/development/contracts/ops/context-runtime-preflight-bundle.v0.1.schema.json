{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Runtime Preflight Bundle v0.1",
  "type": "object",
  "required": [
    "version",
    "bundle_id",
    "current_truth_sources",
    "supporting_sources",
    "preflight_checks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v0.1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "current_truth_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "canonical_contract_docs",
          "canonical_registries_indexes",
          "preserved_completion_audit_artifacts",
          "repo_tracked_files"
        ]
      }
    },
    "supporting_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "external_execution_outputs",
          "local_operation_logs",
          "generated_runtime_summaries"
        ]
      }
    },
    "preflight_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "current_truth_source_check",
          "supporting_source_check",
          "anti_contamination_check",
          "promotion_block_check"
        ]
      }
    }
  },
  "additionalProperties": false
}
