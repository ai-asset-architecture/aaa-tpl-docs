{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result Artifact Eligibility and Evidence Promotion Gate v0.1",
  "type": "object",
  "required": [
    "version",
    "promotion_gate_id",
    "runtime_plane_mode",
    "result_artifact_kind",
    "artifact_eligibility",
    "evidence_class",
    "promotion_eligibility",
    "promotion_decision_source",
    "supporting_review_sources",
    "sole_manual_decision_allowed",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v0.1"
    },
    "promotion_gate_id": {
      "type": "string",
      "const": "result_artifact_evidence_promotion_gate"
    },
    "runtime_plane_mode": {
      "type": "string",
      "const": "result_evidence_gate"
    },
    "result_artifact_kind": {
      "type": "string",
      "enum": [
        "dispatch_result_envelope",
        "readiness_state_report",
        "repo_check_report"
      ]
    },
    "artifact_eligibility": {
      "type": "string",
      "enum": [
        "eligible",
        "ineligible"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "artifact_report",
        "completion_evidence",
        "audit_evidence"
      ]
    },
    "promotion_eligibility": {
      "type": "string",
      "enum": [
        "promotable",
        "blocked"
      ]
    },
    "promotion_decision_source": {
      "type": "string",
      "const": "machine_checkable_gate"
    },
    "supporting_review_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "operator_narrative",
          "manual_review_note",
          "completion_report"
        ]
      }
    },
    "sole_manual_decision_allowed": {
      "type": "boolean",
      "const": false
    },
    "prose_fallback_allowed": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": false
}
