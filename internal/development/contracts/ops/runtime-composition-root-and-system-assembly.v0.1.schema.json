{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Composition Root and System Assembly v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "closeout_role",
    "bootstrap_order",
    "consumed_runtime_planes",
    "consumed_runtime_plane_set_mode",
    "startup_boundary",
    "assembly_outcome",
    "consumed_plane_semantics_rejudgment_allowed",
    "new_primary_law_allowed",
    "conditional_expansion_enabled",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "composition_root" },
    "line_class": { "type": "string", "const": "mandatory_core_absorption_line" },
    "closeout_role": { "type": "string", "const": "core_line_closeout" },
    "bootstrap_order": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "permission_gate",
          "event_stream",
          "session_persistence",
          "runtime_control",
          "result_normalization",
          "workflow_runtime",
          "delegation_lifecycle",
          "extension_plane"
        ]
      }
    },
    "consumed_runtime_planes": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "permission_gate",
          "event_stream",
          "session_persistence",
          "runtime_control",
          "result_normalization",
          "workflow_runtime",
          "delegation_lifecycle",
          "extension_plane"
        ]
      }
    },
    "consumed_runtime_plane_set_mode": { "type": "string", "const": "explicit_enumeration" },
    "startup_boundary": { "type": "string", "enum": ["core_line_only", "core_plus_conditional"] },
    "assembly_outcome": { "type": "string", "enum": ["assembled", "blocked"] },
    "consumed_plane_semantics_rejudgment_allowed": { "type": "boolean", "const": false },
    "new_primary_law_allowed": { "type": "boolean", "const": false },
    "conditional_expansion_enabled": { "type": "boolean", "const": false },
    "prose_fallback_allowed": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
