{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offering Package Materialization and Bootstrap Mapping v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "baseline_scope",
    "post_topology_consumption_required",
    "topology_mapping_precedence_ref",
    "package_level",
    "minimum_repo_set",
    "workflow_inclusion_level",
    "template_sync_required",
    "workflow_enablement_required",
    "governance_asset_load_list",
    "materialization_target_mode",
    "mapping_completeness",
    "dedicated_github_universal_invariant",
    "package_status_assertion_included",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "offering_package_materialization_mapping" },
    "line_class": { "type": "string", "const": "offering_package_runtime_enablement_line" },
    "baseline_scope": { "type": "string", "const": "pre_topology_baseline" },
    "post_topology_consumption_required": { "type": "boolean", "const": true },
    "topology_mapping_precedence_ref": { "type": "string", "const": "v2.1.34" },
    "package_level": { "type": "string", "enum": ["lite", "core", "full"] },
    "minimum_repo_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          ".github",
          "aaa-actions",
          "aaa-evals",
          "aaa-tools",
          "aaa-prompts",
          "aaa-tpl-docs",
          "aaa-tpl-service",
          "aaa-tpl-frontend"
        ]
      }
    },
    "workflow_inclusion_level": { "type": "string", "enum": ["reduced", "core", "full"] },
    "template_sync_required": { "type": "boolean" },
    "workflow_enablement_required": { "type": "boolean" },
    "governance_asset_load_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "ai_command_center",
          "project_playbook",
          "operate_maintain_workflow_v2_reduced",
          "operate_maintain_workflow_v2_core",
          "operate_maintain_workflow_v2_full",
          "prompts_baseline",
          "evals_baseline"
        ]
      }
    },
    "materialization_target_mode": { "type": "string", "const": "repo_template_workflow_asset_mapping" },
    "mapping_completeness": { "type": "string", "enum": ["complete", "partial"] },
    "dedicated_github_universal_invariant": { "type": "boolean", "const": false },
    "package_status_assertion_included": { "type": "boolean", "const": false },
    "prose_fallback_allowed": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
