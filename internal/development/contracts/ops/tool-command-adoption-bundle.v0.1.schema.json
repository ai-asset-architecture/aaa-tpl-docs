{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Command Adoption Bundle v0.1",
  "type": "object",
  "required": [
    "version",
    "tool_refs",
    "command_refs",
    "binding_mode",
    "allowed_authority_map",
    "evidence_targets"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v0.1"
    },
    "tool_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "command_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "binding_mode": {
      "type": "string",
      "enum": [
        "machine_parseable"
      ]
    },
    "allowed_authority_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "read_only",
            "analysis_only",
            "plan_only",
            "advisory_write_draft",
            "mutation_local",
            "mutation_repo",
            "governance_gate",
            "external_side_effect"
          ]
        }
      }
    },
    "evidence_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
