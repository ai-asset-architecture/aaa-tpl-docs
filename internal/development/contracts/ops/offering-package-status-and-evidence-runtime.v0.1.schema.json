{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offering Package Status and Evidence Runtime v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "package_level",
    "package_stage",
    "package_compliance_status",
    "package_runtime_activity",
    "evidence_refs",
    "runtime_activity_requires_minimum_evidence_refs",
    "prerequisite_verdict_used_as_activation",
    "narrative_only_status_allowed",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "offering_package_status_evidence" },
    "line_class": { "type": "string", "const": "offering_package_runtime_enablement_line" },
    "package_level": { "type": "string", "enum": ["lite", "core", "full"] },
    "package_stage": { "type": "string", "enum": ["selected", "resolved", "gated", "materialized"] },
    "package_compliance_status": { "type": "string", "enum": ["compliant", "non_compliant", "compliant_with_gap"] },
    "package_runtime_activity": { "type": "string", "enum": ["active", "inactive"] },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "runtime_activity_requires_minimum_evidence_refs": { "type": "boolean", "const": true },
    "prerequisite_verdict_used_as_activation": { "type": "boolean", "const": false },
    "narrative_only_status_allowed": { "type": "boolean", "const": false },
    "prose_fallback_allowed": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
