{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intermediate Bundle Generation Baseline v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "supported_path_fully_automated",
    "full_orchestration_provided",
    "full_execution_readiness_certified",
    "artifacts"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "intermediate_bundle_generation_baseline" },
    "line_class": { "type": "string", "const": "canonical_path_generation_line" },
    "supported_path_fully_automated": { "type": "boolean", "const": false },
    "full_orchestration_provided": { "type": "boolean", "const": false },
    "full_execution_readiness_certified": { "type": "boolean", "const": false },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_role",
          "artifact_origin",
          "artifact_required_for_step",
          "artifact_not_auto_generated_in_v2_1_42",
          "generation_status",
          "topology_constraints",
          "profile_constraints"
        ],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_role": { "type": "string", "minLength": 1 },
          "artifact_origin": { "type": "string", "enum": ["command_emitted", "client_authored", "external_preexisting"] },
          "artifact_required_for_step": { "type": "boolean" },
          "artifact_not_auto_generated_in_v2_1_42": { "type": "boolean" },
          "generation_status": { "type": "string", "enum": ["automated_in_v2_1_42", "manual_pending", "topology_limited"] },
          "topology_constraints": {
            "type": "array",
            "items": { "type": "string", "enum": ["dedicated_repo", "repo_local", "hybrid"] },
            "minItems": 1
          },
          "profile_constraints": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
