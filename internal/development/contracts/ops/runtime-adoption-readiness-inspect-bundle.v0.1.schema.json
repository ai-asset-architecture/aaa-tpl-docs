{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Adoption Readiness Inspect Bundle v0.1",
  "type": "object",
  "required": [
    "version",
    "command_id",
    "binding_mode",
    "target_scope",
    "target_kind",
    "target_path",
    "allowed_authority",
    "tool_chain_refs",
    "current_truth_sources",
    "supporting_sources",
    "preflight_checks",
    "readiness_surface",
    "readiness_checks",
    "expected_output_artifact",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v0.1"
    },
    "command_id": {
      "type": "string",
      "const": "readiness-inspect"
    },
    "binding_mode": {
      "type": "string",
      "const": "machine_parseable"
    },
    "target_scope": {
      "type": "string",
      "const": "repo_or_worktree"
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "canonical_repo_root",
        "legal_worktree_instance"
      ]
    },
    "target_path": {
      "type": "string",
      "minLength": 1
    },
    "allowed_authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read_only",
          "analysis_only"
        ]
      }
    },
    "tool_chain_refs": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "governance.validate-tool-command-adoption",
          "governance.validate-multi-repo-worktree-identity",
          "governance.validate-context-runtime-preflight",
          "governance.validate-session-readiness-state"
        ]
      }
    },
    "current_truth_sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "canonical_contract_docs",
          "canonical_registries_indexes",
          "preserved_completion_audit_artifacts",
          "repo_tracked_files"
        ]
      }
    },
    "supporting_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "external_execution_outputs",
          "generated_runtime_summaries",
          "local_operation_logs"
        ]
      }
    },
    "preflight_checks": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "current_truth_source_check",
          "supporting_source_check",
          "anti_contamination_check",
          "promotion_block_check"
        ]
      }
    },
    "readiness_surface": {
      "type": "string",
      "enum": [
        "operator_summary",
        "gate_status_surface",
        "readiness_panel"
      ]
    },
    "readiness_checks": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "context_loaded",
          "authority_resolved",
          "preflight_passed",
          "evidence_path_bound"
        ]
      }
    },
    "expected_output_artifact": {
      "type": "string",
      "const": "readiness_state_report"
    },
    "prose_fallback_allowed": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": false
}
