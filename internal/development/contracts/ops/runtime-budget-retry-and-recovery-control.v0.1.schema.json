{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Budget Retry and Recovery Control v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "budget_scope",
    "failure_class",
    "retry_mode",
    "fallback_mode",
    "stop_condition",
    "provider_business_layer_allowed",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "runtime_control" },
    "line_class": { "type": "string", "const": "mandatory_core_absorption_line" },
    "budget_scope": { "type": "string", "enum": ["per_turn", "per_session", "per_workflow"] },
    "failure_class": { "type": "string", "enum": ["retryable", "terminal"] },
    "retry_mode": { "type": "string", "enum": ["limited_retry", "no_retry"] },
    "fallback_mode": { "type": "string", "enum": ["same_path_recovery", "fallback_path", "none"] },
    "stop_condition": { "type": "string", "enum": ["budget_exhausted", "terminal_failure", "retry_limit_reached"] },
    "provider_business_layer_allowed": { "type": "boolean", "const": false },
    "prose_fallback_allowed": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
