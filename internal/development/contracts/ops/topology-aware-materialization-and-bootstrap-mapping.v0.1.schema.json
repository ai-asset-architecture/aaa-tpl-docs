{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topology-Aware Materialization and Bootstrap Mapping v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "topology_mode",
    "materialization_mapping_by_topology",
    "workflow_target_scope",
    "codeowners_target_scope",
    "mapping_completeness",
    "package_active_asserted",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "topology_aware_materialization_and_bootstrap_mapping" },
    "line_class": { "type": "string", "const": "github_governance_topology_support_program" },
    "topology_mode": { "type": "string", "enum": ["dedicated_repo", "repo_local", "hybrid"] },
    "materialization_mapping_by_topology": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["org_repo_only", "repo_local_only", "hybrid_split"] }
    },
    "workflow_target_scope": { "type": "string", "enum": ["org_repo", "repo_local", "split"] },
    "codeowners_target_scope": { "type": "string", "enum": ["org_repo", "repo_local", "split"] },
    "mapping_completeness": { "type": "string", "enum": ["complete", "partial"] },
    "package_active_asserted": { "type": "boolean", "const": false },
    "prose_fallback_allowed": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
