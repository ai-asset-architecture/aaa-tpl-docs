{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topology-Aware Package Status and Repo Checks v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "topology_mode_expected",
    "topology_mode_detected",
    "topology_mode_resolved",
    "topology_compliance_status",
    "missing_governance_assets",
    "misplaced_governance_assets",
    "narrative_only_compliance_allowed",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "topology_aware_package_status_and_repo_checks" },
    "line_class": { "type": "string", "const": "github_governance_topology_support_program" },
    "topology_mode_expected": { "type": "string", "enum": ["dedicated_repo", "repo_local", "hybrid"] },
    "topology_mode_detected": { "type": "string", "enum": ["dedicated_repo", "repo_local", "hybrid", "unknown"] },
    "topology_mode_resolved": { "type": "string", "enum": ["dedicated_repo", "repo_local", "hybrid", "degraded", "not_evaluable"] },
    "topology_compliance_status": { "type": "string", "enum": ["compliant", "non_compliant", "compliant_with_gap"] },
    "missing_governance_assets": { "type": "array", "items": { "type": "string" } },
    "misplaced_governance_assets": { "type": "array", "items": { "type": "string" } },
    "narrative_only_compliance_allowed": { "type": "boolean", "const": false },
    "prose_fallback_allowed": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
