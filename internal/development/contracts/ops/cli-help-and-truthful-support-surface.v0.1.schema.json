{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI Help and Truthful Support Surface v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "supported_path_fully_automated",
    "client_authored_artifacts_present",
    "full_execution_readiness_certified",
    "full_orchestration_provided",
    "truth_boundary",
    "artifacts"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "cli_help_and_truthful_support_surface" },
    "line_class": { "type": "string", "const": "outside_in_follow_up_line" },
    "supported_path_fully_automated": { "type": "boolean", "const": false },
    "client_authored_artifacts_present": { "type": "boolean" },
    "full_execution_readiness_certified": { "type": "boolean", "const": false },
    "full_orchestration_provided": { "type": "boolean", "const": false },
    "truth_boundary": { "type": "string", "const": "support_truth_not_full_readiness" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_origin",
          "artifact_required_for_step",
          "artifact_not_auto_generated_in_v2_1_41",
          "artifact_classification"
        ],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "artifact_origin": { "type": "string", "enum": ["command_emitted", "client_authored", "external_preexisting"] },
          "artifact_required_for_step": { "type": "boolean" },
          "artifact_not_auto_generated_in_v2_1_41": { "type": "boolean" },
          "artifact_classification": { "type": "string", "enum": ["canonical_public_artifact", "diagnostic_or_internal_only_artifact"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
