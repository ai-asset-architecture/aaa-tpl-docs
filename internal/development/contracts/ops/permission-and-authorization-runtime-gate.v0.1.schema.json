{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Permission and Authorization Runtime Gate v0.1",
  "type": "object",
  "required": [
    "version",
    "runtime_plane_mode",
    "line_class",
    "permission_context_ref",
    "command_id",
    "allowed_authority",
    "decision_mode",
    "interactive_mode",
    "non_interactive_mode",
    "primary_law_creation_allowed",
    "prose_fallback_allowed"
  ],
  "properties": {
    "version": { "type": "string", "const": "v0.1" },
    "runtime_plane_mode": { "type": "string", "const": "permission_gate" },
    "line_class": { "type": "string", "const": "mandatory_core_absorption_line" },
    "permission_context_ref": { "type": "string", "const": "internal/development/contracts/ops/tool-contract.v0.1.md" },
    "command_id": { "type": "string", "enum": ["readiness-inspect", "repo-check"] },
    "allowed_authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["read_only", "analysis_only", "governance_gate"] }
    },
    "decision_mode": { "type": "string", "enum": ["allow", "deny", "ask", "auto_deny"] },
    "interactive_mode": { "type": "string", "enum": ["prompt_allowed", "prompt_not_required"] },
    "non_interactive_mode": { "type": "string", "enum": ["auto_deny", "preauthorized_only"] },
    "primary_law_creation_allowed": { "type": "boolean", "const": false },
    "prose_fallback_allowed": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
